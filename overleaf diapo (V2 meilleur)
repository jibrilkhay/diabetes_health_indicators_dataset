\begin{frame}{1. Business Goal: Un pré-diagnostic à grande échelle }
    \textbf{Le Jeu de Données}
    \begin{itemize}
        \item Une base de données construite sur des déclarations de santé.
        \item Elle croise des indicateurs cliniques simples (hypertension, IMC), des habitudes de vie (sport, alimentation, tabagisme).
    \end{itemize}

    \vspace{0.4cm}
    \textbf{Pourquoi ce jeu de données est-il utile? }
    \begin{itemize}
        \item \textbf{La friction actuelle:} Le dépistage traditionnel repose sur des analyses sanguines (invasives, logistiquement lourdes et coûteuses).
        \item \textbf{Notre solution:} Transformer un simple questionnaire en un premier filtre d'alerte algorithmique.
        \item \textbf{L'impact:} Identifier de manière précoce et non-invasive les profils à risque pour mieux orienter les ressources médicales.
    \end{itemize}
\end{frame}

\begin{frame}{2. Data Description: Cartographie de la base de donné}
    \textbf{Aperçu du Dataset : }
    \begin{itemize}
        \item \textbf{Cible (Target) :} Diabetes\_binary (0 ou 1) [cite: 25, 26]
        \item \textbf{21 Features} divisées en : 
        \begin{itemize}
            \item \textbf{14 Binaires} (ex: HighBP, Smoker) 
            \item \textbf{4 Ordinales} (ex: Age, Income) 
            \item \textbf{3 Continues} (ex: BMI) 
        \end{itemize}
    \end{itemize}
