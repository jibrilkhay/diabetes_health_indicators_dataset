\begin{frame}{Business Goal : Un pré-diagnostic à grande échelle}
    
    % Réponse à la question : What is your dataset?
    \begin{block}{W}
        \begin{itemize}
            \item Une base de données construite sur des \textbf{déclarations de santé}.
            \item Elle croise des \textbf{indicateurs cliniques simples} (hypertension, IMC), des \textbf{habitudes de vie} (sport, alimentation, tabagisme) et un \textbf{profil socio-économique}.
        \end{itemize}
    \end{block}
    
    \vspace{0.4cm}
    
    % Réponse à la question : Why is this dataset useful?
    \begin{block}{Why is this dataset useful ?}
        \begin{itemize}
            \item \textbf{La friction actuelle :} Le dépistage traditionnel repose sur des analyses sanguines (invasives, logistiquement lourdes et coûteuses).
            \item \textbf{Notre solution :} Transformer un simple questionnaire en un \textbf{premier filtre d'alerte algorithmique}.
            \item \textbf{L'impact :} Identifier de manière précoce et non-invasive les profils à risque pour mieux orienter les ressources médicales.
        \end{itemize}
    \end{block}
    
\end{frame}
