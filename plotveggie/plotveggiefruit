def plot_rate_from_table(table, column, title, xlabel, order_col=None, rotation=0):
    """
    Affiche le taux de diabète moyen pour une variable.
    Comme Diabetes_binary vaut 0 ou 1, AVG(Diabetes_binary)*100 = taux de diabète.
    """

    if order_col:
        query = f"""
        SELECT
            {order_col},
            {column},
            AVG(Diabetes_binary) * 100 AS diabetes_rate,
            COUNT(*) AS nb_patients
        FROM {table}
        GROUP BY {order_col}, {column}
        ORDER BY {order_col}
        """
    else:
        query = f"""
        SELECT
            {column},
            AVG(Diabetes_binary) * 100 AS diabetes_rate,
            COUNT(*) AS nb_patients
        FROM {table}
        GROUP BY {column}
        ORDER BY {column}
        """

    rate_data = con.execute(query).df()

    plt.figure(figsize=(7, 4))
    sns.lineplot(data=rate_data, x=column, y="diabetes_rate", marker="o")
    plt.title(title)
    plt.xlabel(xlabel)
    plt.ylabel("Taux de diabète (%)")
    plt.grid(True, alpha=0.3)
    plt.xticks(rotation=rotation)
    plt.tight_layout()
    plt.show()

    print("\n", title)
    print(rate_data.to_string(index=False))


def plot_two_vars_and_combination(var1, var2, combined_name, combined_formula, title_combined):
    """
    Fait 4 graphiques :
    1. var1 seule
    2. var2 seule
    3. variable combinée
    4. var1 + var2 ensemble avec Diabetes_binary
    """

    temp_data = con.execute(f"""
    SELECT
        Diabetes_binary,
        {var1},
        {var2},
        {combined_formula} AS {combined_name}
    FROM diabetes_combined_features
    """).df()

    # Variable 1 seule
    rate_var1 = temp_data.groupby(var1)["Diabetes_binary"].mean().reset_index()
    rate_var1["diabetes_rate"] = rate_var1["Diabetes_binary"] * 100

    plt.figure(figsize=(6, 4))
    sns.lineplot(data=rate_var1, x=var1, y="diabetes_rate", marker="o")
    plt.title(f"Taux de diabète selon {var1}")
    plt.xlabel(var1)
    plt.ylabel("Taux de diabète (%)")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

    # Variable 2 seule
    rate_var2 = temp_data.groupby(var2)["Diabetes_binary"].mean().reset_index()
    rate_var2["diabetes_rate"] = rate_var2["Diabetes_binary"] * 100

    plt.figure(figsize=(6, 4))
    sns.lineplot(data=rate_var2, x=var2, y="diabetes_rate", marker="o")
    plt.title(f"Taux de diabète selon {var2}")
    plt.xlabel(var2)
    plt.ylabel("Taux de diabète (%)")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

    # Variable combinée
    rate_combined = temp_data.groupby(combined_name)["Diabetes_binary"].mean().reset_index()
    rate_combined["diabetes_rate"] = rate_combined["Diabetes_binary"] * 100

    plt.figure(figsize=(7, 4))
    sns.lineplot(data=rate_combined, x=combined_name, y="diabetes_rate", marker="o")
    plt.title(title_combined)
    plt.xlabel(combined_name)
    plt.ylabel("Taux de diabète (%)")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

    # Les 3 variables ensemble
    plt.figure(figsize=(7, 5))
    sns.pointplot(
        data=temp_data,
        x=var1,
        y="Diabetes_binary",
        hue=var2,
        errorbar=None
    )
    plt.title(f"Taux de diabète selon {var1} et {var2}")
    plt.xlabel(var1)
    plt.ylabel("Taux moyen de diabète")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

    print("\nTable :", combined_name)
    print(rate_combined.to_string(index=False))


def plot_binary_heatmap(var1, var2, title):
    """
    Heatmap pour deux variables binaires.
    Montre Diabetes_binary en fonction des deux variables.
    """

    heatmap_data = con.execute(f"""
    SELECT
        {var1},
        {var2},
        AVG(Diabetes_binary) * 100 AS diabetes_rate
    FROM diabetes_combined_features
    GROUP BY {var1}, {var2}
    ORDER BY {var1}, {var2}
    """).df()

    pivot_data = heatmap_data.pivot(index=var1, columns=var2, values="diabetes_rate")

    plt.figure(figsize=(6, 5))
    sns.heatmap(
        pivot_data,
        annot=True,
        fmt=".2f",
        cmap="YlOrRd"
    )
    plt.title(title)
    plt.xlabel(var2)
    plt.ylabel(var1)
    plt.tight_layout()
    plt.show()

    print("\n", title)
    print(heatmap_data.to_string(index=False))
    
    
    
