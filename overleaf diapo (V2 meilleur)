\begin{frame}{3. Handcrafted Features : Modéliser la réalité clinique}
    \textbf{1. Indice de Risque Métabolique (Metabolic Risk Index)}
    \begin{itemize}
        \item \textit{Construction :} Agrégation des variables \texttt{BMI} (surpoids), \texttt{HighBP} (Hypertension) et \texttt{HighChol} (Cholestérol).
        \item \textit{Justification :} Ces trois indicateurs définissent le syndrome métabolique, le précurseur physiologique principal du diabète de type 2. L'algorithme capte ainsi une synergie médicale pertinente.
    \end{itemize}
   

    \vspace{0.4cm}
    \textbf{2. Score d'Hygiène de Vie (Lifestyle Score)}
    \begin{itemize}
        \item \textit{Construction :} Somme de l'activité physique et de la consommation de fruits/légumes, pénalisée par le tabagisme.
        \item \textit{Justification :} Regrouper ces habitudes disparates permet de réduire la dimensionnalité tout en créant un indicateur global et robuste du comportement du patient.
    \end{itemize}
\end{frame}

\begin{frame}{4. Regression : Le Moteur de Prédiction}
    \textbf{Choix du Modèle : Régression Logistique}
    \begin{itemize}
        \item \textbf{Adaptation au problème :} Parfaitement adaptée pour notre variable cible binaire (\texttt{Diabetes\_binary}).
        \item \textbf{Storytelling et Interprétabilité :} Contrairement aux réseaux de neurones, la régression logistique fournit des \textit{Odds Ratios}. Nous pouvons expliquer aux médecins l'impact exact de chaque facteur de risque.
    \end{itemize}

    \vspace{0.4cm}
    
    \begin{itemize}
        \item Application d'une régularisation pour éviter le surapprentissage et sélectionner automatiquement les variables les plus discriminantes.
    \end{itemize}
\end{frame}

\begin{frame}{5. Conclusion : Impact et Améliorations Futures}
    \textbf{Bénéfices de cette analyse}
    \begin{itemize}
        \item \textbf{Scalabilité :} Un formulaire en ligne suffit pour obtenir un diagnostic préliminaire instantané.
        \item \textbf{Prévention :} Optimisation des coûts de santé par un ciblage proactif des individus à risque.
    \end{itemize}

