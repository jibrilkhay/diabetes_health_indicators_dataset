heatmap_data = con.execute("""
SELECT
    Fruits,
    Veggies,
    AVG(Diabetes_binary) * 100 AS diabetes_rate
FROM diabetes_eda
GROUP BY Fruits, Veggies
ORDER BY Fruits, Veggies
""").df()

heatmap_pivot = heatmap_data.pivot(index="Fruits", columns="Veggies", values="diabetes_rate")

plt.figure(figsize=(6,5))
sns.heatmap(heatmap_pivot, annot=True, fmt=".2f", cmap="YlOrRd")
plt.title("Taux de diabète (%) selon Fruits et Veggies")
plt.xlabel("Veggies")
plt.ylabel("Fruits")
plt.show()


