FROM diabetes_eda
""").df()

# Créer la combinaison Fruits + Veggies
eda_data["Healthy_Diet"] = eda_data["Fruits"] + eda_data["Veggies"]


healthy_rate = con.execute("""
SELECT
    (Fruits + Veggies) AS Healthy_Diet,
    AVG(Diabetes_binary) AS diabetes_rate
FROM diabetes_eda
GROUP BY Healthy_Diet
ORDER BY Healthy_Diet
""").df()

plt.figure(figsize=(7,5))
sns.lineplot(data=healthy_rate, x="Healthy_Diet", y="diabetes_rate", marker="o")
plt.title("Taux de diabète selon Healthy_Diet = Fruits + Veggies")
plt.xlabel("Healthy_Diet (0 = aucun, 1 = un seul, 2 = les deux)")
plt.ylabel("Taux moyen de diabète")
plt.ylim(0, healthy_rate["diabetes_rate"].max() + 0.05)
plt.grid(True, alpha=0.3)
plt.show()

