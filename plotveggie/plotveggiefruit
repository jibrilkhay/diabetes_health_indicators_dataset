# 1. Création des features combinées cohérentes
# ============================================================

con.execute("""
DROP TABLE IF EXISTS diabetes_combined_features;

CREATE TABLE diabetes_combined_features AS
SELECT
    *,

    -- ========================================================
    -- Mode de vie sain : variables protectrices
    -- PhysActivity, Fruits, Veggies vont dans la même logique
    -- ========================================================
    (PhysActivity + Fruits + Veggies) AS Healthy_Lifestyle,

    -- ========================================================
    -- BMI transformé en score de risque
    -- 0 = BMI normal / faible
    -- 1 = surpoids
    -- 2 = obésité
    -- ========================================================
    CASE
        WHEN BMI < 25 THEN 0
        WHEN BMI >= 25 AND BMI < 30 THEN 1
        WHEN BMI >= 30 THEN 2
        ELSE NULL
    END AS BMI_Risk,

    -- ========================================================
    -- Risque métabolique : BMI + hypertension + cholestérol
    -- ========================================================
    (
        CASE
            WHEN BMI < 25 THEN 0
            WHEN BMI >= 25 AND BMI < 30 THEN 1
            WHEN BMI >= 30 THEN 2
            ELSE 0
        END
        + HighBP
        + HighChol
    ) AS Metabolic_Risk,

    -- ========================================================
    -- Risque cardiovasculaire global
    -- ========================================================
    (HighBP + HighChol + HeartDiseaseorAttack + Stroke) AS Cardio_Risk,

    -- ========================================================
    -- Niveau socio-économique
    -- Education et Income suivent la même logique sociale
    -- ========================================================
    (Education + Income) AS Socio_Economic_Level,

    -- ========================================================
    -- Santé globale
    -- Ces variables décrivent l'état de santé général
    -- ========================================================
    (
        GenHlth
        + 2 * DiffWalk
        + PhysHlth / 30.0
        + MentHlth / 30.0
    ) AS Health_Risk,

    -- ========================================================
    -- Interaction âge + BMI
    -- ========================================================
    (Age * BMI) AS Age_BMI_Interaction

FROM diabetes_eda;
""")

