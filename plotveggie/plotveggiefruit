def plot_diabetes_rate(column, title, xlabel=None, rotation=0):
    rate_data = con.execute(f"""
    SELECT
        {column},
        AVG(Diabetes_binary) * 100 AS diabetes_rate,
        COUNT(*) AS nb_patients
    FROM diabetes_combined_features
    GROUP BY {column}
    ORDER BY {column}
    """).df()

    plt.figure(figsize=(7, 4))
    sns.lineplot(data=rate_data, x=column, y="diabetes_rate", marker="o")
    plt.title(title)
    plt.xlabel(xlabel if xlabel else column)
    plt.ylabel("Taux de diabète (%)")
    plt.grid(True, alpha=0.3)
    plt.xticks(rotation=rotation)
    plt.tight_layout()
    plt.show()

    print("\n" + title)
    print(rate_data.to_string(index=False))


def plot_binary_heatmap(var1, var2, title):
    heatmap_data = con.execute(f"""
    SELECT
        {var1},
        {var2},
        AVG(Diabetes_binary) * 100 AS diabetes_rate,
        COUNT(*) AS nb_patients
    FROM diabetes_combined_features
    GROUP BY {var1}, {var2}
    ORDER BY {var1}, {var2}
    """).df()

    pivot_data = heatmap_data.pivot(index=var1, columns=var2, values="diabetes_rate")

    plt.figure(figsize=(6, 5))
    sns.heatmap(pivot_data, annot=True, fmt=".2f", cmap="YlOrRd")
    plt.title(title)
    plt.xlabel(var2)
    plt.ylabel(var1)
    plt.tight_layout()
    plt.show()

    print("\n" + title)
    print(heatmap_data.to_string(index=False))


