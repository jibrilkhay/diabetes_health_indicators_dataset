# ============================================================
# 2. Création des features combinées
# ============================================================

con.execute("""
DROP TABLE IF EXISTS diabetes_features_logistic;

CREATE TABLE diabetes_features_logistic AS
SELECT
    Diabetes_binary,

    -- Variables originales gardées seules
    Smoker,
    HvyAlcoholConsump,
    Sex,
    NoDocbcCost,
    AnyHealthcare,
    CholCheck,

    -- Mode de vie sain : même tendance protectrice
    (PhysActivity + Fruits + Veggies) AS Healthy_Lifestyle,

    -- BMI transformé en score de risque
    CASE
        WHEN BMI < 25 THEN 0
        WHEN BMI >= 25 AND BMI < 30 THEN 1
        WHEN BMI >= 30 THEN 2
        ELSE NULL
    END AS BMI_Risk,

    -- Risque métabolique : poids + hypertension + cholestérol
    (
        CASE
            WHEN BMI < 25 THEN 0
            WHEN BMI >= 25 AND BMI < 30 THEN 1
            WHEN BMI >= 30 THEN 2
            ELSE 0
        END
        + HighBP
        + HighChol
    ) AS Metabolic_Risk,

    -- Risque cardiovasculaire global
    (HighBP + HighChol + HeartDiseaseorAttack + Stroke) AS Cardio_Risk,

    -- Niveau socio-économique
    (Education + Income) AS Socio_Economic_Level,

    -- Santé globale
    (
        GenHlth
        + 2 * DiffWalk
        + PhysHlth / 30.0
        + MentHlth / 30.0
    ) AS Health_Risk,

    -- Interaction âge + BMI
    (Age * BMI) AS Age_BMI_Interaction

FROM diabetes_clean
WHERE Diabetes_binary IN (0, 1);
""")

print("Table complète pour régression logistique :")
print(con.execute("""
SELECT *
FROM diabetes_features_logistic
LIMIT 5;
""").df())

print("Répartition complète :")
print(con.execute("""
SELECT 
    Diabetes_binary,
    COUNT(*) AS nb_patients
FROM diabetes_features_logistic
