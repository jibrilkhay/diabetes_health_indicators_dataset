# ============================================================
# 3. Table équilibrée : autant de diabétiques que de non diabétiques
# ============================================================

nb_diabetiques = con.execute("""
SELECT COUNT(*)
FROM diabetes_features_logistic
WHERE Diabetes_binary = 1;
""").fetchone()[0]

print("Nombre de diabétiques :", nb_diabetiques)

con.execute(f"""
DROP TABLE IF EXISTS diabetes_logistic_balanced;

CREATE TABLE diabetes_logistic_balanced AS

-- Tous les diabétiques
SELECT *
FROM diabetes_features_logistic
WHERE Diabetes_binary = 1

UNION ALL

-- Même nombre de non diabétiques tirés au hasard
SELECT *
FROM (
    SELECT *
    FROM diabetes_features_logistic
    WHERE Diabetes_binary = 0
    ORDER BY RANDOM()
    LIMIT {nb_diabetiques}
);
""")

print("Répartition de la table équilibrée :")
print(con.execute("""
SELECT 
    Diabetes_binary,
    COUNT(*) AS nb_patients,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pourcentage
FROM diabetes_logistic_balanced
GROUP BY Diabetes_binary
ORDER BY Diabetes_binary;
""").df())





















# Dataset équilibré pour premier entraînement
balanced_data = con.execute("""
SELECT *
FROM diabetes_logistic_balanced
""").df()

# Dataset complet pour test réaliste / comparaison
full_data = con.execute("""
SELECT *
FROM diabetes_features_logistic
""").df()

print("Balanced shape :", balanced_data.shape)
print("Full shape :", full_data.shape)













from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score

# ============================================================
# 5. Train / test sur dataset équilibré
# ============================================================

X = balanced_data.drop("Diabetes_binary", axis=1)
y = balanced_data["Diabetes_binary"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

model = Pipeline([
    ("scaler", StandardScaler()),
    ("logreg", LogisticRegression(max_iter=1000))
])

model.fit(X_train, y_train)

y_pred = model.predict(X_test)
y_proba = model.predict_proba(X_test)[:, 1]

print("Résultats sur dataset équilibré :")
print(confusion_matrix(y_test, y_pred))
print(classification_report(y_test, y_pred))
print("ROC AUC :", roc_auc_score(y_test, y_proba))













# ============================================================
# 6. Évaluation sur le dataset complet non équilibré
# ============================================================

X_full = full_data.drop("Diabetes_binary", axis=1)
y_full = full_data["Diabetes_binary"]

y_full_pred = model.predict(X_full)
y_full_proba = model.predict_proba(X_full)[:, 1]

print("Résultats sur dataset complet non équilibré :")
print(confusion_matrix(y_full, y_full_pred))
print(classification_report(y_full, y_full_pred))
print("ROC AUC :", roc_auc_score(y_full, y_full_proba))



